# Copy to .env for local development (docker compose up -d provides Postgres and Mailpit).

PORT=3001
DATABASE_URL=postgres://klotilda:klotilda@localhost:5435/klotilda
DATABASE_SSL=false
JWT_SECRET=local-development-secret-change-me-please
# The website and the admin; without it (outside production) any origin may call the API.
CORS_ORIGINS=http://localhost:3002,http://localhost:5175
# TRUST_PROXY=1

# Orders are paid by bank transfer to this account (QR Platba).
BANK_ACCOUNT_IBAN=CZ6508000000192000145399
BANK_ACCOUNT_BIC=
BANK_ACCOUNT_DISPLAY=192000145399/0800

# E-mail: RESEND_API_KEY (Resend's HTTP API — Railway blocks outbound SMTP) wins over SMTP_*;
# with neither, e-mails are only logged. Mailpit locally, Resend on Railway.
# RESEND_API_KEY=
FROM_EMAIL=Klotilda <info@klotilda.cz>
SMTP_HOST=localhost
SMTP_PORT=1026
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# New orders are announced here.
ADMIN_EMAIL=admin@klotilda.local

# Photos: without R2_BUCKET, uploads are kept in memory (lost on restart).
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=https://<bucket>.r2.dev

# pnpm --filter @klotilda/api seed:admin
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# Production (NODE_ENV=production) refuses to start without RESEND_API_KEY or SMTP_HOST, R2_* and ADMIN_EMAIL.
