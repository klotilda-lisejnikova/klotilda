{
  "name": "@klotilda/api",
  "version": "0.0.0",
  "private": true,
  "description": "Klotilda REST API on @eleansphere/be-core",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.cjs",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@eleansphere/be-core": "^3.1.0",
    "@eleansphere/entity-core": "^4.1.0",
    "@eleansphere/schema": "^1.1.0",
    "@klotilda/domain": "workspace:*",
    "bcrypt": "^6.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.3",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  }
}
